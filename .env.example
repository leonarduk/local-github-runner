# Copy to .env and edit. Docker Compose reads .env from this directory
# automatically. .env is gitignored; this example is not.
#
#   cp .env.example .env
#
# .env holds what is true of THIS MACHINE. Anything that differs per pool --
# which repository, which compose project -- belongs on the command line
# instead, because one checkout serves several repos and they all read this
# same file. See README.md, "Several repos from one checkout".

# Names the physical machine. It becomes both a runner label and the prefix
# of the runner name, so `gh api .../actions/runners` and the Settings ->
# Actions -> Runners page tell you which box a runner is on. Container
# hostnames are random hex and no help for that.
#
# Leave it unset and runners register with the label "unlabelled-host",
# which is deliberately conspicuous rather than silently anonymous.
RUNNER_HOST_LABEL=bedroom

# The repository the runners register against, as owner/repo. Required --
# compose fails the `up` if it is unset. Setting it here suits a host that
# serves one repo; a host serving several passes it per pool instead:
#
#   GITHUB_REPOSITORY=owner/repo COMPOSE_PROJECT_NAME=gh-runner-repo \
#     docker compose up -d
#
# GITHUB_REPOSITORY=leonarduk/spring-professional-udemy-practice-tests
