# Copy to .env on each runner host and edit. Docker Compose reads .env from
# this directory automatically. .env is gitignored; this example is not.
#
#   cp .env.example .env

# Names the physical machine. It becomes both a runner label and the prefix
# of the runner name, so `gh api .../actions/runners` and the Settings ->
# Actions -> Runners page tell you which box a runner is on. Container
# hostnames are random hex and no help for that.
#
# Leave it unset and runners register with the label "unlabelled-host",
# which is deliberately conspicuous rather than silently anonymous.
RUNNER_HOST_LABEL=bedroom

# Only needed if this pool should serve a different repository.
# GITHUB_REPOSITORY=leonarduk/spring-professional-udemy-practice-tests
